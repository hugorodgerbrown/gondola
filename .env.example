# Copy to .env for local overrides; every value has a safe local default.
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=   # required when DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset locally to use SQLite; set in production.
# DATABASE_URL=postgresql://user:password@localhost:5432/gondola
# SITE_URL=http://localhost:8000          # links in emails; the passkey origin
# SITE_NAME=Gondola                       # the header, page titles and emails
# Email: printed to the console unless DJANGO_DEBUG=0 or EMAIL_BACKEND is set
# (the sign-in page also shows the link in development). For Mailpit:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=0
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL="Gondola <planner@example.com>"
# Basemap: any MapLibre style URL; empty draws a plain map of Switzerland.
# MAP_STYLE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap-winter.vt/style.json
# fivebar analytics: on under SITE_URL's host unless that is local. Set this
# only to count under another domain, or to "" to turn it off.
# FIVEBAR_DOMAIN=gondola.ultraniche.ai
# With it, a fivebar token made to send events only (Settings > API tokens,
# "Send events", not "Read stats") counts each MCP tool call as an event.
# FIVEBAR_TOKEN=
# The token OpenAI's platform issues to verify the domain for ChatGPT's app
# directory, served at /.well-known/openai-apps-challenge (a 404 unless set).
# OPENAI_APPS_CHALLENGE=
