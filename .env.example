SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
# Leave unset locally to use SQLite; set in production.
# DATABASE_URL=postgres://user:password@localhost:5432/gondola

# Shown in the header, page titles and emails.
# SITE_NAME=Gondola
# The public address, for links in emails sent by the nightly command.
# SITE_URL=http://localhost:8000

# Email. Unset in development prints emails to the console (the sign-in
# page also shows the link). For Mailpit: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=planner@example.com

# Basemap: any MapLibre style URL; empty draws a plain map of Switzerland.
# MAP_STYLE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.basemap-winter.vt/style.json

# fivebar analytics: on under SITE_URL's host unless that is local. Set this
# only to count under another domain, or to "" to turn it off.
# FIVEBAR_DOMAIN=gondola.ultraniche.ai
